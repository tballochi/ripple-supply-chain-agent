# Copy this file to .env and add ONE key to enable the LLM mode.
# Without a key the app still works, in a deterministic rule-based mode.

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Mistral (free tier): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Optional: force a provider when both keys are set (groq or mistral)
# RIPPLE_LLM_PROVIDER=groq
